# Copy to .env.local for development. Real values live in Vercel env vars.
# Anything without NEXT_PUBLIC_ is server-only and must never reach the browser.

APP_BASE_URL=https://joeweisman.org

# Neon (Postgres) — server only.
# DATABASE_URL must be the POOLED endpoint (hostname contains "-pooler"): serverless
# functions open a connection per invocation and would exhaust Postgres without it.
# The unpooled one is for migrations — DDL through a transaction-mode pooler is unreliable.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Cloudflare R2 — the archive of photo originals. Nothing public reads from
# here; Cloudflare Images serves the gallery. This exists so the only copy of an
# irreplaceable photograph isn't sitting in one vendor's account. Free tier.
# Needs an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudflare Turnstile.
# The site key is public — it ships in the page source. Do NOT mark it Sensitive
# in Vercel. NEXT_PUBLIC_* is inlined at build time, so changing it needs a redeploy.
# The next two are unquoted — a trailing inline comment on either would become
# part of the value instead of being stripped, since Next's env loader doesn't
# parse inline comments the way some .env tools do.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only; mark Sensitive in Vercel.
TURNSTILE_SECRET=

# Resend — admin notifications only, never the mailing list (that goes by hand
# from Gmail, PLAN.md §6). Verify a SUBDOMAIN, not joeweisman.org: Cloudflare
# Email Routing owns the apex MX records to deliver contact@, and verifying the
# apex in Resend would collide with them and break inbound mail.
RESEND_API_KEY=
RESEND_FROM=notifications@notifications.joeweisman.org
ADMIN_NOTIFY_TO=joeweismanmemorial@gmail.com

# Admin page (/admin) — one long random string, server only. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Unset means nobody can sign in; the gate fails closed.
ADMIN_PASSWORD=

# Salt for hashing submitter IPs. Random, server only. Not optional: IPv4 is
# only 2^32 addresses, so an unsalted hash is brute-forceable in seconds.
# Changing it orphans existing hashes and resets rate limiting — set once.
IP_HASH_SALT=

# Cloudflare Images — Starter Bundle ($5/mo). Not pay-as-you-go: its
# "$5 per 100,000 images stored" is a minimum increment, not metered, so storage
# costs $5 either way and the bundle also covers 500,000 deliveries.
# Both of the next two are server only.
CF_IMAGES_ACCOUNT_ID=
# Needs "Cloudflare Images: Edit".
CF_IMAGES_API_TOKEN=
# Named variant; "public" exists by default.
CF_IMAGES_VARIANT=public
# Smaller variant for the gallery grid and the moderation page. Leave EMPTY until
# the variant exists in the Cloudflare dashboard — a missing variant 404s, which
# would break every image. Named variants are billed as Images Delivered, not as
# transformations, so an extra one costs nothing.
CF_IMAGES_THUMB_VARIANT=
# Account hash from the Images page; public, appears in every image URL.
NEXT_PUBLIC_CF_IMAGES_HASH=

# ── Analytics (optional) ────────────────────────────────────────────────────
# Cloudflare Web Analytics. Leave EMPTY and no beacon is loaded at all — which
# is the right default for a fork, so it never reports to someone else's account.
#
# Get it from the Cloudflare dashboard → Web Analytics → Add a site → the token
# inside the data-cf-beacon snippet. Public by design: it appears in the page
# source. Works with DNS-only (grey cloud); no proxying required.
#
# Chosen over Vercel's because it keeps more than one month of history and
# stores no cookie, no localStorage and no IP address.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
